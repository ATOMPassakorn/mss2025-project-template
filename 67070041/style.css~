@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');

body {
  font-family: 'Inter', Arial, sans-serif;
  background: linear-gradient(#d60000, #6b0000);
  color: white;
  margin: 0;
  padding: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

.dashboard {
  width: 90%;
  max-width: 900px;
  background: rgba(255, 255, 255, 0.15);
  padding: 20px;
  border-radius: 20px;
  backdrop-filter: blur(10px);
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
  border: 2px solid rgba(255, 255, 255, 0.3);
}

h1 {
  text-align: center;
  font-size: 2rem;
  margin-bottom: 20px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
}

.card {
	background: rgba(0, 0, 0, 0.3);
  padding: 15px;
  border-radius: 15px;
  box-shadow: 0 0 10px rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.card h2 {
  margin: 0 0 10px;
  font-size: 1.3rem;
  color: #ffecb3;
}

.value {
  font-size: 1.6rem;
  font-weight: bold;
  color: #ffffff;
}

.footer {
  margin-top: 20px;
  text-align: center;
  font-size: 1.1rem;
  color: #ffecb3;
}



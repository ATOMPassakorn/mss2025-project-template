<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="refresh" content="60">
    <title>DBLearn - Server Status</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #ffffff;
        }

        /* --- Header / Navbar --- */
        .navbar {
            background-color: #0a1f38; /* สีน้ำเงินเข้มเกือบดำ */
            padding: 15px 0;
        }
        .navbar-brand {
            font-weight: bold;
            color: white !important;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .navbar-text-right {
            color: white;
            display: flex;
            align-items: center;
            gap: 20px;
            font-size: 14px;
        }
        .flag-icon {
            width: 24px;
            height: 16px;
            cursor: pointer;
        }

        /* --- Hero Section (ส่วนบนสีน้ำเงิน) --- */
        .hero-section {
            /* ถ้ามีรูปพื้นหลังกระดานดำ ให้ใส่ url ที่นี่ */
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            padding: 80px 0;
            position: relative;
            overflow: hidden;
        }
        /* สร้างลายเส้นจางๆ จำลองพื้นหลัง (Optional) */
        .hero-section::before {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: url('https://www.transparenttextures.com/patterns/math.png'); /* ลาย Math */
            opacity: 0.1;
        }
        
        .hero-content {
            position: relative;
            z-index: 2;
        }
        
        .hero-title {
            font-size: 3rem;
            font-weight: bold;
            line-height: 1.2;
            margin-bottom: 20px;
        }
        
        .hero-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin-bottom: 30px;
            line-height: 1.8;
        }
        
        .btn-enter-course {
            background-color: #3498db;
            border: none;
            padding: 12px 30px;
            font-size: 1rem;
            border-radius: 4px;
            color: white;
            transition: background 0.3s;
        }
        .btn-enter-course:hover {
            background-color: #2980b9;
            color: white;
        }

        .hero-image-box {
            text-align: right;
        }
        .hero-image-box img {
            max-width: 100%;
            height: auto;
            /* Drop shadow ให้กล่องดูนูน */
            filter: drop-shadow(10px 10px 20px rgba(0,0,0,0.3));
        }

        /* --- Section Header --- */
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 40px;
            margin-bottom: 20px;
            border-bottom: 1px solid #eee;
            padding-bottom: 10px;
        }
        .section-title {
            font-size: 1rem;
            font-weight: bold;
            color: #555;
            text-transform: uppercase;
            border-bottom: 3px solid #3498db;
            padding-bottom: 10px;
            margin-bottom: -12px; /* ดึงเส้นให้ทับเส้นเทา */
        }

        /* --- Cards --- */
        .course-card {
            border: 1px solid #e0e0e0;
            border-radius: 4px;
            transition: transform 0.2s, box-shadow 0.2s;
            margin-bottom: 30px;
            background: white;
        }
        .course-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .card-img-top {
            height: 180px;
            object-fit: cover;
            background-color: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #aaa;
            font-size: 3rem;
        }
        .card-body {
            padding: 20px;
        }
        .card-title {
            font-size: 1.1rem;
            color: #444;
            margin-bottom: 5px;
            height: 50px; /* จัดความสูงให้เท่ากัน */
            overflow: hidden;
        }
        .card-subtitle {
            font-size: 0.85rem;
            color: #888;
            margin-bottom: 15px;
        }
        .card-footer-custom {
            border-top: 1px solid #eee;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #666;
            font-size: 0.9rem;
        }
        .btn-open {
            border: 1px solid #ddd;
            background: white;
            color: #666;
            padding: 5px 15px;
            border-radius: 4px;
            font-size: 0.85rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .btn-open:hover {
            background-color: #f8f9fa;
            color: #333;
        }

        /* --- Footer --- */
        footer {
            background-color: #000;
            color: #666;
            text-align: center;
            padding: 20px;
            margin-top: 50px;
            font-size: 0.8rem;
        }

        /* Utility สำหรับแสดงผล Script */
        pre {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 4px;
            font-size: 0.7rem;
            max-height: 200px;
            overflow-y: auto;
            border: 1px solid #ddd;
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="fas fa-layer-group fa-lg text-warning"></i>
                DBLearn
            </a>
            <div class="navbar-text-right">
                <span>{{TIME}}</span> <a href="#" class="text-white text-decoration-none">Login</a>
                <img src="https://upload.wikimedia.org/wikipedia/commons/a/a9/Flag_of_Thailand.svg" class="flag-icon" alt="TH">
                <img src="https://upload.wikimedia.org/wikipedia/en/a/a4/Flag_of_the_United_States.svg" class="flag-icon" alt="US">
                <i class="fas fa-bars ms-3"></i>
            </div>
        </div>
    </nav>

    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 hero-content">
                    <h1 class="hero-title">Learning online is easier<br>than ever before</h1>
                    <div class="hero-subtitle">
                        <b>Anything</b> you wish.<br>
                        <b>Anywhere</b> you want.<br>
                        <b>Anytime</b> you like.
                    </div>
                    <button class="btn-enter-course">Enter Course</button>
                </div>
                <div class="col-lg-6 hero-image-box d-none d-lg-block">
                    <img src="https://cdn-icons-png.flaticon.com/512/2921/2921226.png" style="max-width: 350px;" alt="Learning Box"> 
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="section-header">
            <div class="section-title">Available Class (Server Status)</div>
            <a href="#" class="btn btn-primary btn-sm">View All</a>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="course-card">
                    <div class="card-img-top text-center pt-4">
                        <i class="fas fa-microchip fa-3x text-primary"></i>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">CPU Load & Usage</h5>
                        <p class="card-text text-muted">
                            Usage: <b>{{CPU}}%</b>
                            <div class="progress mt-2" style="height: 5px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: {{CPU}}%"></div>
                            </div>
                        </p>
                    </div>
                    <div class="card-footer-custom">
                        <div><i class="fas fa-users"></i> Core</div>
                        <a href="#" class="btn-open"><i class="far fa-folder-open"></i> Open</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="course-card">
                    <div class="card-img-top" style="background: #a00; color: white;">
                         <i class="fas fa-memory fa-3x"></i>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">Memory System Concept</h5>
                         <p class="card-text text-muted">
                            Usage: <b>{{MEM}}%</b>
                            <div class="progress mt-2" style="height: 5px;">
                                <div class="progress-bar bg-danger" role="progressbar" style="width: {{MEM}}%"></div>
                            </div>
                        </p>
                    </div>
                    <div class="card-footer-custom">
                        <div><i class="fas fa-users"></i> RAM</div>
                        <a href="#" class="btn-open"><i class="far fa-folder-open"></i> Open</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="course-card">
                    <div class="card-img-top" style="background: #0a1f38; color: white;">
                        <i class="fas fa-hdd fa-3x"></i>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">Storage & Network I/O</h5>
                        <p class="card-text small">
                            Disk: {{DISK}}<br>
                            Net RX: {{RX}} | TX: {{TX}}
                        </p>
                    </div>
                    <div class="card-footer-custom">
                        <div><i class="fas fa-users"></i> I/O</div>
                        <a href="#" class="btn-open"><i class="far fa-folder-open"></i> Open</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-header">
            <div class="section-title">System Internals</div>
        </div>
        <div class="row">
             <div class="col-md-6">
                 <h6>Neofetch</h6>
                 {{NEOFETCH}}
             </div>
             <div class="col-md-6">
                 <h6>Top Processes</h6>
                 {{TOP}}
             </div>
        </div>

    </div>

    <footer>
        Copyright &copy; 2016-2025 Faculty of Information Technology. All rights reserved.<br>
        Created by AtomPassakorn [67070134]
    </footer>

</body>
</html>
